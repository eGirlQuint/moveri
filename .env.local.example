# Copy this file to .env.local (dev) or set these as real environment
# variables on the production server — never commit the actual values.

# Discord webhook URL for the /contact form. Create one in Discord:
# Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL.
# Keep this secret — anyone with the URL can post messages into the channel.
DISCORD_WEBHOOK_URL=

# Zoho SMTP credentials so the /contact form also emails submissions to your
# Zoho inbox (in addition to Discord). Use a Zoho app-specific password, not
# your account password: Zoho Mail -> Settings -> Security -> App Passwords.
# Leave these unset to skip email delivery entirely (Discord still works).
ZOHO_SMTP_HOST=smtp.zoho.eu
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=

# Optional: where contact emails are sent. Defaults to ZOHO_SMTP_USER, so
# only set this if you want them delivered to a different Zoho address.
CONTACT_EMAIL_TO=